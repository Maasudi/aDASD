<!DOCTYPE html>
<html>
<head>
    <title>Add Student</title>

    <style>
        body {
            font-family: Arial;
            background: #f4f6f8;
            padding: 30px;
        }

        .container {
            max-width: 600px;
            margin: auto;
            background: white;
            padding: 30px;
            border-radius: 10px;
        }

        input, select {
            width: 100%;
            padding: 10px;
            margin: 8px 0 15px;
            box-sizing: border-box;
        }

        button {
            background: #198754;
            color: white;
            padding: 12px 20px;
            border: none;
            cursor: pointer;
        }

        a {
            text-decoration: none;
        }
    </style>
</head>

<body>

<div class="container">

    <h1>Add Student</h1>

    <form method="POST">

        <label>Admission Number</label>
        <input
            type="text"
            name="admission_no"
            required
        >

        <label>Student Name</label>
        <input
            type="text"
            name="name"
            required
        >

        <label>Age</label>
        <input
            type="number"
            name="age"
            min="1"
            max="100"
        >

        <label>Gender</label>

        <select name="gender">
            <option value="">Select Gender</option>
            <option value="Male">Male</option>
            <option value="Female">Female</option>
        </select>

        <label>Class</label>
        <input
            type="text"
            name="class_name"
            placeholder="e.g. Grade 7"
        >

        <label>Parent/Guardian Name</label>
        <input
            type="text"
            name="parent_name"
        >

        <label>Parent/Guardian Phone</label>
        <input
            type="tel"
            name="phone"
            placeholder="07XXXXXXXX"
        >

        <button type="submit">
            Save Student
        </button>

    </form>

    <br>

    <a href="/">← Back to Students</a>

</div>

</body>
</html>
